[Unit]
Description=NestLink v15 control service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nestlink-v15
Group=nestlink-v15
WorkingDirectory=/var/lib/nestlink-v15
ExecCondition=/usr/bin/python3 /usr/lib/nestlink-v15-tools/server/lifecycle.py assert-ready --role server --require-config
ExecStart=/usr/lib/nestlink-v15/server/current/nestlink-server installed-control --state-root /var/lib/nestlink-v15
KillSignal=SIGTERM
TimeoutStopSec=45
SendSIGKILL=no
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=nestlink-v15
StateDirectoryMode=0700
RuntimeDirectory=nestlink-v15
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nestlink-v15 /run/nestlink-v15
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
